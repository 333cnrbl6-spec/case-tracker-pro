{
  "name": "BillingInvoice",
  "type": "object",
  "properties": {
    "firm_email": {
      "type": "string",
      "description": "Firm's email"
    },
    "invoice_number": {
      "type": "string",
      "description": "Unique invoice ID (e.g., INV-2026-0001)"
    },
    "stripe_invoice_id": {
      "type": "string",
      "description": "Stripe invoice ID for tracking"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "Date invoice was issued"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "billing_period_start": {
      "type": "string",
      "format": "date",
      "description": "Billing cycle start"
    },
    "billing_period_end": {
      "type": "string",
      "format": "date",
      "description": "Billing cycle end"
    },
    "tier_name": {
      "type": "string",
      "enum": [
        "Free",
        "Starter",
        "Professional",
        "Premium",
        "Enterprise"
      ],
      "description": "Subscription tier billed"
    },
    "amount_gbp": {
      "type": "number",
      "description": "Invoice amount in GBP"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft",
      "description": "Payment status"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "When invoice was paid"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL to download invoice PDF"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      },
      "description": "Itemized charges"
    }
  },
  "required": [
    "firm_email",
    "invoice_number",
    "invoice_date",
    "tier_name",
    "amount_gbp"
  ]
}